TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# Comma-separated numeric Telegram user IDs allowed to use the bot (get yours
# from @userinfobot). Required in practice: without it, anyone who finds your
# bot can run Claude Code with permission checks bypassed.
TELEGRAM_ALLOWED_USER_IDS=123456789

# LTA DataMall API key for /bus (free signup):
# https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_API_KEY=your-lta-datamall-account-key

# Optional overrides — defaults shown are usually fine.
# CLAUDE_BIN=claude
# CLAUDE_WORKDIR=/path/claude/should/run/in
# CLAUDE_MODEL=sonnet
# CLAUDE_PERMISSION_MODE=bypassPermissions
# CLAUDE_TIMEOUT_SECONDS=600
# ACCOUNTS_FILE=/workspace/telegram-bot/accounts.hash
# ACCOUNTS_DIR=/workspace/telegram-bot/accounts
# SESSION_TIMEOUT_SECONDS=900
# INTERESTS_REORGANIZE_INTERVAL_SECONDS=86400
# BUS_STOPS_CACHE_FILE=/workspace/telegram-bot/bus_stops_cache.json
# BUS_NEARBY_COUNT=3
# NEWS_LEARNING_ENABLED=true
# NEWS_HISTORY_WINDOW_DAYS=60
# NEWS_HISTORY_MAX_ENTRIES=100
# ENV_FILE=/workspace/telegram-bot/.env
# ADMIN_ACCOUNT_ID=amy
# ADMIN_TELEGRAM_USER_ID=100000001
